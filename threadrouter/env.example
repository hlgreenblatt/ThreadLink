# ThreadRouter / watch-film demo — environment (PLACEHOLDERS ONLY, no real values)
# Copy to .env and fill with your own keys. NEVER commit a filled .env.

# Router
TK_ROUTER=on
TK_SPEND_CAP_USD=25
MEMORY_DIR=/path/to/agent/memory

# Local (own-GPU, free + private)
TK_LOCAL_CHAT_URL=http://YOUR_LOCAL_HOST:11434/v1
TK_LOCAL_CHAT_MODEL=your-local-model

# Paid vision path (approval-gated)
GEMINI_API_KEY=YOUR_GEMINI_KEY_HERE
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-flash-latest

# Other paid paths (all approval-gated)
GROK_API_KEY=YOUR_GROK_KEY_HERE
GROK_URL=https://api.x.ai/v1
GROK_MODEL=grok-4
